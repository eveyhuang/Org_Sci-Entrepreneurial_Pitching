{
  "$defs": {
    "EpisodeRecord_PREP_SUBS": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "description": "what was said or done that this judgment rests on",
          "maxLength": 600,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "turn_refs": {
          "description": "transcript turn indices (tN) the judgment rests on",
          "items": {
            "type": "integer"
          },
          "title": "Turn Refs",
          "type": "array"
        },
        "uncodable": {
          "description": "true when the evidence needed to judge this code is absent",
          "title": "Uncodable",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "ordinal answer; null only when uncodable",
          "title": "Value"
        }
      },
      "required": [
        "uncodable",
        "evidence",
        "turn_refs",
        "value"
      ],
      "title": "EpisodeRecord_PREP_SUBS",
      "type": "object"
    },
